                android:background="@drawable/bg_white_round_6"
                android:backgroundTint="#FBFBFB"
                android:elevation="@dimen/_1sdp"
                app:layout_constraintBottom_toBottomOf="@id/tvNameValue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvNameValue" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:elevation="@dimen/_1sdp"
                android:gravity="center|start"
                android:text="@string/farmer_name"
                android:textColor="@color/textLight"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintBottom_toBottomOf="@id/tvNameValue"
                app:layout_constraintEnd_toStartOf="@id/tvNameValue"
                app:layout_constraintStart_toStartOf="@id/viewBgName"
                app:layout_constraintTop_toTopOf="@id/tvNameValue"

                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvNameValue"
