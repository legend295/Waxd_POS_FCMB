                android:text="@string/loan_amount"
                android:textColor="@color/textLight"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintBottom_toBottomOf="@id/tvEmailValue"
                app:layout_constraintEnd_toStartOf="@id/tvEmailValue"
                app:layout_constraintStart_toStartOf="@id/viewBgEmail"
                app:layout_constraintTop_toTopOf="@id/tvEmailValue"
