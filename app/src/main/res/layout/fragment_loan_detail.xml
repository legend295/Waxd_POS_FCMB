<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.waxd.pos.fcmb.ui.main.fragments.loan.details.LoanDetailViewModel" />

        <variable
            name="data"
            type="com.waxd.pos.fcmb.rest.FarmerLoanApplicationData" />

        <variable
            name="viewClickHandler"
            type="com.waxd.pos.fcmb.utils.handlers.ViewClickHandler" />

        <import type="android.view.View" />

        <import type="com.waxd.pos.fcmb.utils.Util" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/parent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".ui.main.fragments.loan.details.LoanDetailFragment">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLoanInformation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_15sdp"
                android:gravity="center|start"
                android:text="@string/loan_information"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                app:fontFamily="@font/poppins_medium"
                app:layout_constraintEnd_toStartOf="@id/tvBvnNumberValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />


            <!--  BVN Number  -->

            <View
                android:id="@+id/viewBgBvn"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:background="@drawable/bg_white_round_6"
                android:backgroundTint="#FBFBFB"
                android:elevation="@dimen/_1sdp"
                app:layout_constraintBottom_toBottomOf="@id/tvBvnNumber"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvBvnNumber" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBvnNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:elevation="@dimen/_1sdp"
                android:gravity="center|start"
                android:padding="@dimen/_10sdp"
                android:text="@string/bvn_number"
                android:textColor="@color/textLight"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintBottom_toBottomOf="@id/tvBvnNumberValue"
                app:layout_constraintEnd_toStartOf="@id/tvBvnNumberValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvBvnNumberValue"

                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBvnNumberValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:elevation="@dimen/_1sdp"
                android:gravity="end"
                android:text="@{data.bvnNumber}"
                android:padding="@dimen/_10sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintEnd_toEndOf="@id/viewBgBvn"
                app:layout_constraintStart_toEndOf="@id/tvBvnNumber"
                app:layout_constraintTop_toBottomOf="@id/tvWalletNumberValue"
                tools:text="938495834958"
                tools:visibility="visible" />


            <!--  Wallet Number  -->

            <View
                android:id="@+id/viewBgWallet"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:background="@drawable/bg_white_round_6"
                android:backgroundTint="#FBFBFB"
                android:elevation="@dimen/_1sdp"
                app:layout_constraintBottom_toBottomOf="@id/tvWalletNumberValue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvWalletNumberValue" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvWalletNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:elevation="@dimen/_1sdp"
                android:gravity="center|start"
                android:text="@string/loan_application_number"
                android:textColor="@color/textLight"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintBottom_toBottomOf="@id/tvWalletNumberValue"
                app:layout_constraintEnd_toStartOf="@id/tvWalletNumberValue"
                app:layout_constraintStart_toStartOf="@id/viewBgWallet"
                app:layout_constraintTop_toTopOf="@id/tvWalletNumberValue"

                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvWalletNumberValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:elevation="@dimen/_1sdp"
                android:gravity="end"
                android:padding="@dimen/_10sdp"
                android:text="@{data.loanApplicationNumber}"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                android:visibility="@{data.loanApplicationNumber!=null? View.VISIBLE : View.INVISIBLE,default=gone}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvWalletNumber"
                app:layout_constraintTop_toBottomOf="@id/tvLoanInformation"
                tools:text="938495834958"
                tools:visibility="visible" />

            <!--  Name  -->

            <View
                android:id="@+id/viewBgName"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/_10sdp"
