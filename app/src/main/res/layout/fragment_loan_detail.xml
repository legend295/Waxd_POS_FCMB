                android:textSize="@dimen/_12sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvPhoneNumber"
                app:layout_constraintTop_toBottomOf="@id/tvNameValue"
